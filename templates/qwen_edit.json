{
 "qe:unet": {
  "class_type": "UnetLoaderGGUF",
  "inputs": {
   "unet_name": "Qwen\\qwen-image-edit-2511-Q6_K.gguf"
  },
  "_meta": {
   "title": "Load Diffusion Model (Qwen Image Edit)"
  }
 },
 "qe:clip": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "Qwen\\qwen_2.5_vl_7b_fp8_scaled.safetensors",
   "type": "qwen_image",
   "device": "default"
  },
  "_meta": {
   "title": "Load CLIP (Qwen 2.5 VL 7B)"
  }
 },
 "qe:vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "Qwen-Image\\Qwen_Image_VAE.safetensors"
  },
  "_meta": {
   "title": "Load VAE (Qwen Image)"
  }
 },
 "qe:img": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "example-source.png"
  },
  "_meta": {
   "title": "Load Source Image"
  }
 },
 "qe:scale": {
  "class_type": "ImageScaleToTotalPixels",
  "inputs": {
   "image": [
    "qe:img",
    0
   ],
   "upscale_method": "lanczos",
   "megapixels": 1.0,
   "resolution_steps": 8
  },
  "_meta": {
   "title": "Scale Source to Working Megapixels (set by builder)"
  }
 },
 "qe:pos": {
  "class_type": "TextEncodeQwenImageEdit",
  "inputs": {
   "clip": [
    "qe:clip",
    0
   ],
   "image": [
    "qe:img",
    0
   ],
   "prompt": "TEMPLATE_PLACEHOLDER_INSTRUCTION"
  },
  "_meta": {
   "title": "Encode Edit Instruction (VL only - no VAE)"
  }
 },
 "qe:neg": {
  "class_type": "TextEncodeQwenImageEdit",
  "inputs": {
   "clip": [
    "qe:clip",
    0
   ],
   "image": [
    "qe:img",
    0
   ],
   "prompt": ""
  },
  "_meta": {
   "title": "Encode Negative (VL only - no VAE)"
  }
 },
 "qe:latent": {
  "class_type": "VAEEncode",
  "inputs": {
   "pixels": [
    "qe:scale",
    0
   ],
   "vae": [
    "qe:vae",
    0
   ]
  },
  "_meta": {
   "title": "Encode Source Latent"
  }
 },
 "qe:ref": {
  "class_type": "ReferenceLatent",
  "inputs": {
   "conditioning": [
    "qe:pos",
    0
   ],
   "latent": [
    "qe:latent",
    0
   ]
  },
  "_meta": {
   "title": "Set Reference Latent (positive)"
  }
 },
 "qe:refneg": {
  "class_type": "ReferenceLatent",
  "inputs": {
   "conditioning": [
    "qe:neg",
    0
   ],
   "latent": [
    "qe:latent",
    0
   ]
  },
  "_meta": {
   "title": "Set Reference Latent (negative)"
  }
 },
 "qe:shift": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": [
    "qe:unet",
    0
   ],
   "shift": 3.0
  },
  "_meta": {
   "title": "Model Sampling Shift"
  }
 },
 "qe:cfgnorm": {
  "class_type": "CFGNorm",
  "inputs": {
   "model": [
    "qe:shift",
    0
   ],
   "strength": 1.0
  },
  "_meta": {
   "title": "CFG Norm"
  }
 },
 "qe:sampler": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "qe:cfgnorm",
    0
   ],
   "positive": [
    "qe:ref",
    0
   ],
   "negative": [
    "qe:refneg",
    0
   ],
   "latent_image": [
    "qe:latent",
    0
   ],
   "seed": 11111,
   "steps": 20,
   "cfg": 2.5,
   "sampler_name": "euler",
   "scheduler": "simple",
   "denoise": 1.0
  },
  "_meta": {
   "title": "KSampler"
  }
 },
 "qe:decode": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "qe:sampler",
    0
   ],
   "vae": [
    "qe:vae",
    0
   ]
  },
  "_meta": {
   "title": "VAE Decode"
  }
 },
 "qe:save": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "qe:decode",
    0
   ],
   "filename_prefix": "pixal_dm/qwen_edit"
  },
  "_meta": {
   "title": "Save Image"
  }
 }
}
